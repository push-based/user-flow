{
  "extends": "nx/presets/core.json",
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true
    }
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/babel.config.json"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/eslint.config.mjs"
    ]
  },
  "targetDefaults": {
    "build": {
      "inputs": ["production", "^production"]
    },
    "test": [
      {
        "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"]
      },
      {
        "filter": {
          "plugin": "@nx/vitest"
        },
        "inputs": ["default", "^production"]
      }
    ],
    "lint": [
      {
        "inputs": [
          "default",
          "{workspaceRoot}/.eslintrc.json",
          "{workspaceRoot}/eslint.config.mjs"
        ]
      },
      {
        "filter": {
          "plugin": "@nx/eslint/plugin"
        },
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/.eslintrc.json",
          "{workspaceRoot}/eslint.config.mjs",
          "{workspaceRoot}/tools/eslint-rules/**/*"
        ]
      }
    ],
    "nx-release-publish": {
      "dependsOn": ["build"],
      "options": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
      }
    }
  },
  "generators": {
    "@push-based/user-flow-nx-plugin:target": {
      "targetName": "user-flow"
    }
  },
  "nxCloudAccessToken": "MDlmODg4OTQtYWVlZC00OGVkLTgyMjktMDc3OWQ5ZjU1ZTAxfHJlYWQtd3JpdGU=",
  "useInferencePlugins": false,
  "defaultBase": "origin/main",
  "release": {
    "projects": ["cli", "nx-plugin"],
    "projectsRelationship": "independent",
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "createRelease": "github"
      }
    },
    "git": {
      "commit": true,
      "commitMessage": "release: publish",
      "commitArgs": "--no-verify",
      "tag": true,
      "push": true,
      "pushRemote": "origin"
    },
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      }
    },
    "releaseTag": {
      "pattern": "{projectName}-{version}"
    }
  },
  "affected": {
    "legacy": true
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "e2e/cli-e2e/**/*",
        "packages/cli/**/*",
        "packages/nx-plugin/**/*",
        "packages/nx-plugin-integration/**/*",
        "packages/user-flow-example/**/*"
      ]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "include": ["packages/nx-plugin/**/*"]
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "run",
        "testTargetName": "test"
      }
    },
    {
      "plugin": "@nx/webpack/plugin",
      "options": {
        "buildTargetName": "build",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "serveTargetName": "serve"
      }
    }
  ]
}
