{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "docs",
  "sourceRoot": "packages/docs/src",
  "tags": [
    "type:docs"
  ],
  "targets": {
    "content-dates": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node packages/docs/scripts/content-dates.mjs"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/packages/docs",
        "browser": "packages/docs/src/main.ts",
        "server": "packages/docs/src/main.server.ts",
        "outputMode": "static",
        "tsConfig": "packages/docs/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "packages/docs/public"
          }
        ],
        "styles": [
          "packages/docs/src/styles.scss"
        ],
        "loader": {
          ".md": "text"
        }
      },
      "configurations": {
        "production": {
          "baseHref": "/user-flow/",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "600kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "fonts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            }
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "dependsOn": [
        "content-dates"
      ]
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4300
      },
      "configurations": {
        "production": {
          "buildTarget": "docs:build:production"
        },
        "development": {
          "buildTarget": "docs:build:development"
        }
      },
      "dependsOn": [
        "content-dates"
      ]
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": [
        "build"
      ],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "docs:build:development",
        "staticFilePath": "dist/packages/docs/browser",
        "spa": true
      }
    }
  }
}
