{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/cli/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "command": "tsdown",
      "cache": true,
      "options": {
        "cwd": "packages/cli"
      },
      "inputs": [
        "production",
        "^production",
        {
          "externalDependencies": [
            "tsdown"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/packages/cli"
      ]
    },
    "link": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build"
      ],
      "options": {
        "commands": [
          {
            "command": "cd ./dist/packages/cli"
          },
          {
            "command": "npx cpx \"./dist/packages/cli/**\" ./node_modules/@push-based/user-flow"
          }
        ]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs cli {args.ver} {args.tag}",
      "dependsOn": [
        "build"
      ]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/packages/cli"
      }
    },
    "test": {
      "options": {
        "cwd": ".",
        "args": [
          "--root",
          "packages/cli"
        ]
      }
    }
  }
}
