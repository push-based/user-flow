{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/cli/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/cli",
        "main": "packages/cli/src/index.ts",
        "tsConfig": "packages/cli/tsconfig.lib.json",
        "assets": [
          "README.md",
          {
            "input": "./packages/cli",
            "glob": "*.md",
            "output": "."
          },
          {
            "input": "./packages/cli/src",
            "glob": "cli.mjs",
            "output": "./src"
          },
          {
            "input": "./packages/cli",
            "glob": "*.schema.json",
            "output": "."
          },
          {
            "input": "./packages/cli/src",
            "glob": "**/static/**",
            "output": "./src"
          }
        ]
      }
    },
    "link": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          {
            "command": "cd ./dist/packages/cli"
          },
          {
            "command": "npx cpx \"./dist/packages/cli/**\" ./node_modules/@push-based/user-flow"
          }
        ]
      }
    },
    "publish": {
      "command": "node tools/scripts/publish.mjs cli {args.ver} {args.tag}",
      "dependsOn": ["build"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/packages/cli"
      }
    },
    "test": {
      "options": {
        "cwd": ".",
        "args": ["--root", "packages/cli"]
      }
    }
  }
}
